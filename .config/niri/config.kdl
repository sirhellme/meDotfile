// ═══════════════════════════════════════════════════════════════════════════
//  niri — main compositor config
//  Structure:
//    modules/monitors.kdl      outputs + modes
//    modules/inputs.kdl        keyboard / touchpad
//    modules/startup.kdl       environment, cursor, autostart
//    modules/keybinds.kdl      all binds (intentionally unchanged)
//    modules/window-rules.kdl  radii, opacity, blur
//    noctalia.kdl              generated palette (keep last: it owns colors)
// ═══════════════════════════════════════════════════════════════════════════

include "modules/monitors.kdl"
include "modules/inputs.kdl"
include "modules/startup.kdl"
include "modules/keybinds.kdl"
include "modules/window-rules.kdl"

// Generated by Noctalia from the skwd-wall palette. Do not hand-edit colors.
include "noctalia.kdl"

prefer-no-csd

// ── Layout ─────────────────────────────────────────────────────────────────
// Small gaps to maximise usable space; 1px borders; radius lives in
// window-rules.kdl so every window shares the same 10px corner.
layout {
    gaps 4

    focus-ring {
        width 0.5
    }

    border {
        width 0
    }

    shadow {
        off
    }
}

// ── Motion ─────────────────────────────────────────────────────────────────
// 0.25 = noticeably faster than niri's default 1.0.
animations {
    slowdown 0.25
}

gestures {
    hot-corners {
        off
    }
}

// ── Glass ──────────────────────────────────────────────────────────────────
// Two passes are enough for the Vega 8 and keep idle GPU load low.
blur {
    passes 2
    offset 2
    noise 0.015
    saturation 1.0
}

// ── Layer surfaces ─────────────────────────────────────────────────────────
layer-rule {
    match namespace="^noctalia-overview*"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-(background|launcher-overlay|dock)-.*$"
    background-effect {
        xray false
    }
}

screenshot-path "~/Pictures/Screenshots/Screenshot-%Y%m%d-%H%M%S.png"

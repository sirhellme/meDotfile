// ═══════════════════════════════════════════════════════════════════════════
//  Outputs
//  eDP-1 is the internal 1080p panel (scale 1.0). HDMI-A-1 is optional.
// ═══════════════════════════════════════════════════════════════════════════

output "eDP-1" {
    mode "1920x1080@60.003"
    scale 1.0
}

output "HDMI-A-1" {
    mode "1920x1080@60"
    scale 1.0
}
